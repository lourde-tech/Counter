# Copy to .env.local for local runs. On Vercel, set these in Project Settings ->
# Environment Variables. They are baked in at build time, so redeploy after changing them.

# Shown as "Message us at ..." (an email becomes a mailto link, a phone number an sms link).
NEXT_PUBLIC_TEAM_CONTACT=team@example.com

# The Google Form's viewform URL (must be https).
NEXT_PUBLIC_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform

# Our field names -> the form's entry IDs. "entry.123" and "123" both work. Missing fields are skipped.
NEXT_PUBLIC_FORM_ENTRY_IDS={"caseCode":"entry.1","decision":"entry.2","copied":"entry.3","emailOpened":"entry.4","edited":"entry.5","askType":"entry.6","thinEvidence":"entry.7","stopReasons":"entry.8"}
